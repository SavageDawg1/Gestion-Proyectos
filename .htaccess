# Habilitar mod_rewrite
RewriteEngine On

# Evitar listado de directorios y descarga directa de respaldos/base de datos
Options -Indexes

RewriteRule ^(?:config|includes|sql|PHPMyAdmin)(?:/|$) - [F,L,NC]

<FilesMatch "\.(?:sql|sqlite|sqlite3|db|bak|backup|dump|zip)$">
    Require all denied
</FilesMatch>

# Redirigir todo a index.php si el archivo no existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]
